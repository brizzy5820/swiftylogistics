import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';

export function FirstTimeOnboardingModal({ isOpen, onClose, onComplete, initialMode = 'customer' }) {
  const [selectedMode, setSelectedMode] = useState(initialMode);
  const [selectedTheme, setSelectedTheme] = useState('dark');

  if (!isOpen) return null;

  const handleSave = () => {
    localStorage.setItem('app_theme_pref', selectedTheme);
    localStorage.setItem('app_theme_onboarded', 'true');
    localStorage.setItem('app_active_mode', selectedMode);

    const root = document.documentElement;
    root.classList.remove('light', 'dark');
    if (selectedTheme === 'system') {
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      root.classList.add(isDark ? 'dark' : 'light');
    } else {
      root.classList.add(selectedTheme);
    }

    onComplete?.({ mode: selectedMode, theme: selectedTheme });
    onClose?.();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
      <div className="w-full max-w-md rounded-2xl border border-slate-800 bg-slate-900 text-slate-100 p-6 shadow-2xl space-y-6">
        <div>
          <span className="inline-block px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-500/15 text-emerald-400 mb-2">
            Welcome! Set Up Your Experience
          </span>
          <h2 className="text-xl font-bold tracking-tight">How are you mounting in today?</h2>
          <p className="text-sm text-slate-400 mt-1">
            Your account supports both Customer and Driver modes. You can switch anytime from your Account page.
          </p>
        </div>

        <div className="space-y-2.5">
          <label className="text-xs font-semibold uppercase tracking-wider text-slate-400">
            1. Choose Your Mounting Mode
          </label>
          <div className="grid grid-cols-2 gap-3">
            <button
              type="button"
              onClick={() => setSelectedMode('customer')}
              className={`p-4 rounded-xl border text-left transition-all ${
                selectedMode === 'customer'
                  ? 'border-emerald-500 bg-emerald-500/10 text-white ring-2 ring-emerald-500/30'
                  : 'border-slate-800 bg-slate-800/50 text-slate-300 hover:border-slate-700'
              }`}
            >
              <div className="font-semibold text-sm">Customer</div>
              <div className="text-xs text-slate-400 mt-1">Book rides & send packages</div>
            </button>

            <button
              type="button"
              onClick={() => setSelectedMode('rider')}
              className={`p-4 rounded-xl border text-left transition-all ${
                selectedMode === 'rider'
                  ? 'border-emerald-500 bg-emerald-500/10 text-white ring-2 ring-emerald-500/30'
                  : 'border-slate-800 bg-slate-800/50 text-slate-300 hover:border-slate-700'
              }`}
            >
              <div className="font-semibold text-sm">Driver / Rider</div>
              <div className="text-xs text-slate-400 mt-1">Accept orders & earn money</div>
            </button>
          </div>
        </div>

        <div className="space-y-2.5">
          <label className="text-xs font-semibold uppercase tracking-wider text-slate-400">
            2. Select Your Theme Preference
          </label>
          <div className="grid grid-cols-3 gap-2.5">
            {['light', 'dark', 'system'].map((t) => (
              <button
                key={t}
                type="button"
                onClick={() => setSelectedTheme(t)}
                className={`py-2.5 px-3 rounded-xl border text-xs font-medium capitalize transition-all ${
                  selectedTheme === t
                    ? 'border-emerald-500 bg-emerald-500/15 text-emerald-300'
                    : 'border-slate-800 bg-slate-800/50 text-slate-400 hover:border-slate-700'
                }`}
              >
                {t}
              </button>
            ))}
          </div>
        </div>

        <button
          type="button"
          onClick={handleSave}
          className="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition-colors"
        >
          Continue as {selectedMode === 'rider' ? 'Driver' : 'Customer'}
        </button>
      </div>
    </div>
  );
}

export function RoleModeSwitchCard({ currentMode = 'customer', isGuest = false, onSwitchMode }) {
  const navigate = useNavigate();
  const targetMode = currentMode === 'rider' ? 'customer' : 'rider';

  const handleToggle = () => {
    if (isGuest) {
      // Guests cannot use driver mode -> redirect to driver login
      navigate('/auth?mode=rider&view=login');
      return;
    }
    if (onSwitchMode) {
      onSwitchMode(targetMode);
    } else {
      localStorage.setItem('app_active_mode', targetMode);
      navigate(targetMode === 'rider' ? '/rider/dashboard' : '/customer/dashboard');
    }
  };

  return (
    <div className="rounded-2xl border border-border bg-card p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
      <div>
        <div className="flex items-center gap-2">
          <span className="text-sm font-semibold text-foreground">
            Current Mode: {currentMode === 'rider' ? 'Driver / Rider' : 'Customer'}
          </span>
          <span className="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-medium">
            Shared Account
          </span>
        </div>
        <p className="text-xs text-muted-foreground mt-1">
          {isGuest
            ? 'Want to earn as a driver? Sign in to a registered driver account (Guest mode is disabled for drivers).'
            : `Switch seamlessly to ${targetMode === 'rider' ? 'Driver mode to start receiving delivery & ride orders' : 'Customer mode to book rides and deliveries'}.`}
        </p>
      </div>
      <button
        type="button"
        onClick={handleToggle}
        className="w-full sm:w-auto shrink-0 px-4 py-2.5 rounded-xl bg-primary text-primary-foreground font-semibold text-xs hover:opacity-90 transition"
      >
        {isGuest
          ? 'Sign In to Drive →'
          : `Switch to ${targetMode === 'rider' ? 'Driver Mode' : 'Customer Mode'}`}
      </button>
    </div>
  );
}
